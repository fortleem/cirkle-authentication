// Cirkle Authentication — Central SSO Identity Provider
// Unified identity (username) reaching personal + business contexts across the ecosystem

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                String   @id @default(cuid())
  // The single "1 username" that reaches the whole ecosystem
  username          String   @unique
  email             String   @unique
  name              String
  passwordHash      String
  avatarUrl         String?
  phone             String?
  // Verification status — drives which apps the user can authorize
  emailVerified     Boolean  @default(true)
  phoneVerified     Boolean  @default(false)
  kycVerified       Boolean  @default(false)
  businessVerified  Boolean  @default(false)
  twoFactorEnabled  Boolean  @default(false)
  twoFactorSecret   String?
  // Recovery codes (top-of-line 2FA fallback) — bcrypt-hashed, one-time use
  recoveryCodesHash String?
  recoveryCodesGeneratedAt DateTime?
  // Post-quantum ML-DSA-65 identity attestation (FIPS 204)
  pqAttestationPubKey String?
  pqAttestationSig    String?
  pqAttestationMsg    String?
  pqAttestationAt     DateTime?
  // Emergency lockdown state
  locked              Boolean  @default(false)
  lockedAt            DateTime?
  // Onboarding state
  onboardingComplete Boolean  @default(false)
  role              String   @default("member")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  lastLoginAt       DateTime?
  sessions          Session[]
  appAccess         UserAppAccess[]
  auditLogs         AuditLog[]
  ownedBusinesses   Business[] @relation("BusinessOwner")
  businessMemberships UserBusiness[]
  passkeys           Passkey[]
  guardians          Guardian[]
}

// Social Recovery (M-of-N Shamir's Secret Sharing)
// Each user designates N guardians; a recovery secret is split into N shares,
// one stored per guardian (encrypted-at-rest share). Any M reconstruct it.
model Guardian {
  id          String   @id @default(cuid())
  userId      String   // the protected user
  label       String   // friendly name for the guardian
  handle      String   // guardian's @username or email
  share       String   // base64 Shamir share (held in escrow for the demo)
  threshold   Int      // M (copied per-row for convenience)
  total       Int      // N
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Passkey {
  id            String   @id @default(cuid())
  userId        String
  // WebAuthn credential ID (base64url)
  credentialId  String   @unique
  publicKey     String
  counter       Int      @default(0)
  deviceType    String?
  transports    String?
  name          String   @default("Passkey")
  createdAt     DateTime @default(now())
  lastUsedAt    DateTime?
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Session {
  id         String   @id @default(cuid())
  userId     String
  token      String   @unique
  ip         String?
  userAgent  String?
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Business {
  id            String   @id @default(cuid())
  name          String
  legalName     String?
  taxId         String?
  type          String   @default("sole")  // sole, llc, corp, partnership
  country       String?
  industry      String?
  verified      Boolean  @default(false)
  ownerId       String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  owner         User     @relation("BusinessOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members       UserBusiness[]
}

model UserBusiness {
  id          String   @id @default(cuid())
  userId      String
  businessId  String
  role        String   @default("member")  // owner, admin, member
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([userId, businessId])
  @@index([userId])
}

model ConnectedApp {
  id                String   @id @default(cuid())
  slug              String   @unique
  name              String
  description       String
  category          String
  color             String
  icon              String
  homepage          String
  redirectUrl       String?
  featured          Boolean  @default(false)
  status            String   @default("active")
  // Dynamic authentication requirements per platform
  identityType      String   @default("either")    // personal | business | either
  verificationLevel String   @default("basic")    // basic | enhanced | strict
  twoFactorRequired Boolean  @default(false)
  businessRequired  Boolean  @default(false)
  requiredScopes    String   @default("openid profile email")
  createdAt         DateTime @default(now())
  userAccess        UserAppAccess[]

  @@index([slug])
}

model UserAppAccess {
  id          String   @id @default(cuid())
  userId      String
  appId       String
  scopes      String   @default("openid profile email")
  // Context: personal vs. business (for business-required apps)
  contextType String   @default("personal")  // personal | business
  businessId  String?
  grantedAt   DateTime @default(now())
  lastUsedAt  DateTime?
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  app         ConnectedApp @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@unique([userId, appId])
  @@index([userId])
  @@index([appId])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  ip         String?
  userAgent  String?
  metadata   String?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}
